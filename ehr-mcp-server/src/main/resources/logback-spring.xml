<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!--
    stdout is the MCP JSON-RPC channel, so every log line goes to stderr.
    Never log PHI: IDs, event names, counts and durations only.
  -->
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!--
    Benign start-up warnings from Spring AI internals. Tools are registered with @Tool, so the
    @McpTool annotation scanner legitimately finds nothing.
  -->
  <logger name="org.springframework.context.support.PostProcessorRegistrationDelegate$BeanPostProcessorChecker" level="ERROR"/>
  <logger name="org.springframework.ai.mcp.annotation.provider.tool" level="ERROR"/>

  <root level="WARN">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
