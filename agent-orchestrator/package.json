{
  "name": "@auratriage/agent-orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express + LangGraph.js orchestrator that talks to the EHR MCP server over stdio.",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "dev:mock": "node --env-file=dev/mock.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint": "^1.2.1",
    "@langchain/mcp-adapters": "^2.0.1",
    "@langchain/ollama": "^1.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
