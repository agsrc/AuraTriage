# Copy to .env at the repo root (never commit .env). Empty values count as unset.

# --- orchestrator ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# At least 16 characters. Production refuses the development value.
JWT_SECRET=dev-only-change-me
# Demo sign-in is on in development and refused in production.
ENABLE_DEMO_LOGIN=true
DEMO_PATIENT_IDS=P-1001,P-1002,P-1003,P-1004,P-1005

# fake = offline scripted model (no key, no cost); anthropic = Claude
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# jar = spawn the Java server; mock = Node stand-in for machines without JDK 25
EHR_MCP_SERVER=jar
# Path to the built JAR (repo-relative or absolute)
EHR_MCP_JAR=ehr-mcp-server/target/ehr-mcp-server.jar
# Optional: java executable to run the JAR (defaults to JAVA_HOME, then PATH)
JAVA_BIN=

# sqlite = pauses and the nurse queue survive a restart; memory = lost on restart
PERSISTENCE=sqlite
CHECKPOINT_DB=agent-orchestrator/data/checkpoints.sqlite

# --- privacy: tracing is forced off at start-up whatever these say ---
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# --- web ---
# Leave empty in development: the browser calls its own origin and the Vite dev server proxies /api.
# Setting it to the orchestrator's URL would bypass the proxy, and the API has no CORS.
VITE_API_BASE_URL=
# Where the Vite dev proxy forwards /api. Not PORT: that one belongs to the orchestrator.
API_PROXY_TARGET=http://127.0.0.1:3001
